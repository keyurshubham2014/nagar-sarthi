# Copy to server/.env (git-ignored). Real environment variables take precedence.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_MS=20000
PORT=8787
DATABASE_URL=postgres://nagar:nagar@localhost:5435/nagar_sarthi
# Engine output the server loads. Defaults to engine/out/audit.json.
# AUDIT_PATH=
# Sign-in (TASK-07). The fixed demo code; the app never hardcodes it.
DEMO_LOGIN_CODE=246810
# Signs session tokens. Set a long random value; the dev default is for a laptop demo only.
AUTH_SECRET=
# on: GET /api/auth/demo gives the app's "Demo:" shortcuts the code. Set off outside a demo.
DEMO_SHORTCUTS=on
